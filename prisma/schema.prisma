// Prisma schema for খালি খাই (Khali Khai)
// Multi-Restaurant Food Delivery & Smart Shared Logistics Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  phone        String?
  name         String
  passwordHash String
  role         String             @default("CUSTOMER") // CUSTOMER, RESTAURANT_MANAGER, RIDER, ADMIN
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  customerProfile   CustomerProfile?
  riderProfile      RiderProfile?
  managedRestaurant Restaurant?
  auditLogs         AuditLog[]
}

model CustomerProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddressId String?
  createdAt        DateTime          @default(now())
  
  addresses        Address[]
  orders           ParentOrder[]
  loyaltyProgress  LoyaltyProgress[]
}

model Address {
  id          String   @id @default(uuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String   @default("Home") // Home, Work, Other
  fullAddress String
  area        String   // e.g. Dhanmondi, Gulshan, Banani, Mirpur
  city        String   @default("Dhaka")
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  parentOrders ParentOrder[]
}

model Restaurant {
  id                     String                    @id @default(uuid())
  nameBn                 String
  nameEn                 String
  slug                   String                    @unique
  descriptionBn          String?
  descriptionEn          String?
  phone                  String
  email                  String?
  address                String
  area                   String
  city                   String                    @default("Dhaka")
  latitude               Float
  longitude              Float
  image                  String
  coverImage             String?
  isOpen                 Boolean                   @default(true)
  acceptsOrders          Boolean                   @default(true)
  rating                 Float                     @default(4.8)
  reviewCount            Int                       @default(120)
  minOrderAmount         Int                       @default(100) // in Taka (BDT)
  avgPrepTimeMinutes     Int                       @default(20)
  maxClusterRadiusMeters Int                       @default(600)
  managerUserId          String?                   @unique
  managerUser            User?                     @relation(fields: [managerUserId], references: [id])
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  operatingHours         RestaurantOperatingHour[]
  categories             MenuCategory[]
  menuItems              MenuItem[]
  subOrders              RestaurantSubOrder[]
  deliveryStops          DeliveryStop[]
}

model RestaurantOperatingHour {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime     String     // e.g. "09:00"
  closeTime    String     // e.g. "23:00"
  isClosed     Boolean    @default(false)
}

model MenuCategory {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nameBn       String
  nameEn       String
  sortOrder    Int        @default(0)

  items        MenuItem[]
}

model MenuItem {
  id                     String       @id @default(uuid())
  restaurantId           String
  restaurant             Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId             String
  category               MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameBn                 String
  nameEn                 String
  descriptionBn          String?
  descriptionEn          String?
  price                  Int          // Price in BDT (Integer taka)
  image                  String
  isAvailable            Boolean      @default(true)
  preparationTimeMinutes Int          @default(15)
  sortOrder              Int          @default(0)
  createdAt              DateTime     @default(now())

  orderItems             OrderItem[]
}

model ParentOrder {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique // KK-YYYYMMDD-XXXX
  customerId              String
  customer                CustomerProfile      @relation(fields: [customerId], references: [id])
  deliveryAddressId       String
  deliveryAddress         Address              @relation(fields: [deliveryAddressId], references: [id])
  status                  String               @default("PENDING_PAYMENT") // PENDING_PAYMENT, CONFIRMED, PREPARING, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentMethod           String               @default("BKASH") // BKASH, NAGAD, CARD, COD
  paymentStatus           String               @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  foodSubtotal            Int                  // BDT
  separateDeliveryFee     Int                  // What it would cost ordering separately
  combinedDeliveryFee     Int                  // Actual delivery fee
  deliverySavings         Int                  // separateDeliveryFee - combinedDeliveryFee
  firstOrderDiscount      Int                  @default(0)
  loyaltyDiscount         Int                  @default(0)
  totalAmount             Int                  // final amount paid
  notes                   String?
  estimatedDeliveryMinutes Int                 @default(35)
  routeType               String               @default("SHARED") // SHARED, SPLIT
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  subOrders               RestaurantSubOrder[]
  deliveryPlans           DeliveryPlan[]
  payments                Payment[]
}

model RestaurantSubOrder {
  id                        String      @id @default(uuid())
  parentOrderId             String
  parentOrder               ParentOrder @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  restaurantId              String
  restaurant                Restaurant  @relation(fields: [restaurantId], references: [id])
  status                    String      @default("PENDING_ACCEPTANCE") // PENDING_ACCEPTANCE, ACCEPTED, PREPARING, READY_FOR_PICKUP, PICKED_UP, DELIVERED, REJECTED, CANCELLED
  subtotal                  Int
  restaurantPrepTimeMinutes Int         @default(20)
  estimatedReadyTime        DateTime?
  actualReadyTime           DateTime?
  rejectionReason           String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  items                     OrderItem[]
}

model OrderItem {
  id             String             @id @default(uuid())
  subOrderId     String
  subOrder       RestaurantSubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem           @relation(fields: [menuItemId], references: [id])
  itemNameBn     String
  itemNameEn     String
  itemPrice      Int
  quantity       Int
  totalItemPrice Int
  instructions   String?
}

model DeliveryPlan {
  id                       String             @id @default(uuid())
  parentOrderId            String
  parentOrder              ParentOrder        @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  planType                 String             @default("SHARED") // SHARED, SPLIT
  totalDistanceKm          Float              @default(2.5)
  estimatedDurationMinutes Int                @default(30)
  riderPayout              Int                @default(80)
  status                   String             @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt                DateTime           @default(now())

  stops                    DeliveryStop[]
  assignments              RiderAssignment[]
}

model DeliveryStop {
  id               String       @id @default(uuid())
  deliveryPlanId   String
  deliveryPlan     DeliveryPlan @relation(fields: [deliveryPlanId], references: [id], onDelete: Cascade)
  stopSequence     Int          // 1, 2, 3...
  stopType         String       // PICKUP, DROPOFF
  restaurantId     String?
  restaurant       Restaurant?  @relation(fields: [restaurantId], references: [id])
  addressText      String
  latitude         Float
  longitude        Float
  estimatedArrival DateTime?
  actualArrival    DateTime?
  isCompleted      Boolean      @default(false)
}

model RiderProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType     String            @default("BICYCLE") // BICYCLE, MOTORCYCLE
  licenseNumber   String?
  isOnline        Boolean           @default(true)
  currentLat      Float             @default(23.7465)
  currentLng      Float             @default(90.3760)
  totalDeliveries Int               @default(45)
  rating          Float             @default(4.9)
  createdAt       DateTime          @default(now())

  assignments     RiderAssignment[]
}

model RiderAssignment {
  id             String       @id @default(uuid())
  deliveryPlanId String
  deliveryPlan   DeliveryPlan @relation(fields: [deliveryPlanId], references: [id], onDelete: Cascade)
  riderId        String
  rider          RiderProfile @relation(fields: [riderId], references: [id])
  assignedAt     DateTime     @default(now())
  acceptedAt     DateTime?
  completedAt    DateTime?
  status         String       @default("ACCEPTED") // OFFERED, ACCEPTED, IN_TRANSIT, COMPLETED, CANCELLED
}

model Payment {
  id             String      @id @default(uuid())
  parentOrderId  String
  parentOrder    ParentOrder @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  amount         Int
  method         String      @default("BKASH")
  status         String      @default("COMPLETED") // PENDING, COMPLETED, FAILED
  transactionId  String      @unique
  paymentDetails String?
  createdAt      DateTime    @default(now())
}

model LoyaltyProgress {
  id                            String          @id @default(uuid())
  customerId                    String
  customer                      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  monthYear                     String          // e.g. "2026-10"
  qualifyingCompletedOrdersCount Int            @default(0)
  thresholdMet                  Boolean         @default(false) // true if > 15
  discountPercentageEarned      Int             @default(0) // 25
  expiresAt                     DateTime?
  updatedAt                     DateTime        @updatedAt

  @@unique([customerId, monthYear])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  details      String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}
